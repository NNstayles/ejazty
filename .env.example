# Copy to `.env` and fill in from your Supabase project:
#   Project Settings -> Data API  (URL)
#   Project Settings -> API Keys  (anon / publishable key)
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle at build time. The anon
# key is meant to be public — protect your data with Row Level Security, not by
# hiding this value. Never put the service_role key here.
#
# Restart the dev server after changing these; they are not hot-reloaded.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
